<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Configurations>Debug;Release;RelWithDebInfo;MinSizeRel</Configurations>
		<Platforms>AnyCPU</Platforms>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<RootNamespace>FyuuStudio</RootNamespace>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="11.3.1" />
		<PackageReference Include="Avalonia.Desktop" Version="11.3.1" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.1" />
	</ItemGroup>

	<Target Name="CopyNativeRuntime" AfterTargets="Build"
	        Condition="'$(FyuuNativeOutputDir)' != '' And Exists('$(FyuuNativeOutputDir)')">
		<ItemGroup>
			<NativeRuntime Include="$(FyuuNativeOutputDir)/*.dll" />
		</ItemGroup>
		<Copy SourceFiles="@(NativeRuntime)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
	</Target>

</Project>
